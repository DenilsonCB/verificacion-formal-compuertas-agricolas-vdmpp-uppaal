class Canal
types
    public Volumen = real
    inv v == v >= 0.0;

instance variables
    public id : token;
    public volumen_actual : Volumen;
    public capacidad_maxima : Volumen;

    -- INVARIANTE CLAVE: El canal jamas puede contener mas agua que su capacidad
    inv volumen_actual <= capacidad_maxima;

operations
    public Canal: token * Volumen ==> Canal
    Canal(c_id, cap_max) == (
        id := c_id;
        capacidad_maxima := cap_max;
        volumen_actual := 0.0;
    )
    pre cap_max > 0.0;

    public ObtenerId: () ==> token
    ObtenerId() == return id;

    public InyectarAgua: Volumen ==> ()
    InyectarAgua(vol) == (
        volumen_actual := volumen_actual + vol;
    )
    pre (volumen_actual + vol) <= capacidad_maxima;

    public DrenarAgua: Volumen ==> ()
    DrenarAgua(vol) == (
        volumen_actual := volumen_actual - vol;
    )
    pre (volumen_actual - vol) >= 0.0;

    public AdmiteFlujo: Volumen ==> bool
    AdmiteFlujo(flujo_entrante) == (
        return (volumen_actual + flujo_entrante) <= capacidad_maxima;
    );

end Canal

