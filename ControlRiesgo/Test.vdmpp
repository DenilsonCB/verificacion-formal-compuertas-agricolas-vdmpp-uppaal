class Test
operations
    private static AssertTrue: bool ==> ()
    AssertTrue(cond) == return
    pre cond;

    static public EjecutarPruebas: () ==> bool
    EjecutarPruebas() == (
        dcl token_z1 : token := mk_token("Zona1");
        dcl token_z2 : token := mk_token("Zona2");
        dcl token_z3 : token := mk_token("Zona3");

        dcl sensor_z1 : Sensor := new Sensor(token_z1, 5.0);
        dcl compuerta_z1 : Compuerta := new Compuerta(token_z1);
        dcl canal_z1 : Canal := new Canal(token_z1, 50.0);

        dcl sensor_z2 : Sensor := new Sensor(token_z2, 25.0);
        dcl sensor_z3 : Sensor := new Sensor(token_z3, 5.0);
        dcl compuerta_z3 : Compuerta := new Compuerta(token_z3);

        dcl control : Controlador := new Controlador();

        -- 1. Armado de red (Map) e historial inicial vacio (Seq)
        control.RegistrarSensor(sensor_z1);
        control.RegistrarCompuerta(compuerta_z1);
        control.RegistrarCanal(canal_z1);
        AssertTrue(len control.historial_telemetria = 0);

        -- 2. Escenario 1: Flujo Normal (5.0 m3/s) -> apertura parcial y total con inyeccion real en Canal
        control.EvaluarRed();
        AssertTrue(control.SolicitarApertura(token_z1, 50, 10.0) = true);
        AssertTrue(compuerta_z1.ObtenerEstado() = <PARCIAL>);
        AssertTrue(canal_z1.volumen_actual = 10.0);

        AssertTrue(control.SolicitarApertura(token_z1, 100, 10.0) = true);
        AssertTrue(compuerta_z1.ObtenerEstado() = <ABIERTA>);
        AssertTrue(canal_z1.volumen_actual = 20.0);

        -- 3. Escenario 2: Flujo Precaucion (12.0 m3/s) -> cierre parcial preventivo al 50%
        sensor_z1.ActualizarCaudal(12.0);
        control.EvaluarRed();
        AssertTrue(compuerta_z1.ObtenerEstado() = <PARCIAL>);
        AssertTrue(compuerta_z1.porcentaje_apertura = 50);
        AssertTrue(token_z1 not in set control.alarmas_activas);

        -- 4. Escenario 3: Alerta Critica (20.0 m3/s) -> cierre total, alarma y drenaje automatico (-5.0)
        sensor_z1.ActualizarCaudal(20.0);
        control.EvaluarRed();
        AssertTrue(compuerta_z1.ObtenerEstado() = <CERRADA>);
        AssertTrue(token_z1 in set control.alarmas_activas);
        AssertTrue(canal_z1.volumen_actual = 15.0);

        -- 5. Escenario 4: Bloqueo por alarma activa y alivio supervisado de canal (< 5.0 y == 0.0)
        AssertTrue(control.SolicitarApertura(token_z1, 100, 10.0) = false);
        AssertTrue(control.AliviarCanal(token_z1, 12.0) = true);
        AssertTrue(canal_z1.volumen_actual = 3.0);
        -- Rechazo de drenaje excesivo (3.0 < 5.0)
        AssertTrue(control.AliviarCanal(token_z1, 5.0) = false);
        -- Reevaluacion critica cuando volumen < 5.0 (no sobre-drena)
        control.EvaluarRed();
        AssertTrue(canal_z1.volumen_actual = 3.0);
        -- Drenaje exacto a 0.0 y reevaluacion critica con canal vacio (0.0)
        AssertTrue(control.AliviarCanal(token_z1, 3.0) = true);
        AssertTrue(canal_z1.volumen_actual = 0.0);
        control.EvaluarRed();
        AssertTrue(canal_z1.volumen_actual = 0.0);

        -- 6. Escenario 5: Retorno a la normalidad y rechazo por capacidad maxima (50.0 m3)
        sensor_z1.ActualizarCaudal(5.0);
        control.EvaluarRed();
        AssertTrue(token_z1 not in set control.alarmas_activas);
        AssertTrue(control.SolicitarApertura(token_z1, 50, 100.0) = false);

        -- 7. Escenario 6: Topologia asimetrica (Zona2 sin compuerta/canal, Zona3 sin canal)
        control.RegistrarSensor(sensor_z2);
        control.RegistrarSensor(sensor_z3);
        control.RegistrarCompuerta(compuerta_z3);
        control.EvaluarRed();
        AssertTrue(token_z2 in set control.alarmas_activas);
        AssertTrue(control.SolicitarApertura(token_z3, 50, 10.0) = false);

        -- Cubrir <PRECAUCION> sin compuerta (Zona2) y <CRITICO> con compuerta sin canal (Zona3)
        sensor_z2.ActualizarCaudal(12.0);
        sensor_z3.ActualizarCaudal(20.0);
        control.EvaluarRed();
        AssertTrue(token_z2 not in set control.alarmas_activas);
        AssertTrue(token_z3 in set control.alarmas_activas);
        AssertTrue(compuerta_z3.ObtenerEstado() = <CERRADA>);

        -- Verificar registro cronologico completo en secuencia (6*1 + 2*3 = 12 lecturas)
        AssertTrue(len control.historial_telemetria = 12);

        return true;
    );

end Test
